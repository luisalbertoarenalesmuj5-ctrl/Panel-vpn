{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated VPN panel administrator workspace profile and global security settings.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of workspace owner." },
        "displayName": { "type": "string", "description": "Administrator display name." },
        "email": { "type": "string", "format": "email", "description": "Verified Google account email." },
        "role": { "type": "string", "enum": ["SUPER_ADMIN"], "description": "Workspace owner role." },
        "panelName": { "type": "string", "description": "Custom brand name for this VPN panel." },
        "defaultDns": { "type": "string", "description": "Default DNS servers for generated VPN profiles." },
        "defaultMtu": { "type": "integer", "description": "Default WireGuard MTU value." },
        "defaultSubnet": { "type": "string", "description": "Default tunnel CIDR subnet." },
        "autoSuspendExpired": { "type": "boolean", "description": "Automatically mark expired VPN users as suspended." },
        "apiTimeoutSeconds": { "type": "integer", "description": "HTTP timeout in seconds when polling VPS agents." },
        "maskSensitiveKeys": { "type": "boolean", "description": "Mask VPS API tokens and VPN private keys in UI by default." },
        "createdAt": { "type": "string", "format": "date-time", "description": "Server timestamp of workspace creation." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Server timestamp of last workspace update." }
      },
      "required": ["userId", "displayName", "email", "role", "panelName", "defaultDns", "defaultMtu", "defaultSubnet", "autoSuspendExpired", "apiTimeoutSeconds", "maskSensitiveKeys", "createdAt", "updatedAt"]
    },
    "VpsServer": {
      "title": "VpsServer",
      "description": "Self-hosted VPS node managed via its HTTP API agent.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ipAddress": { "type": "string" },
        "location": { "type": "string" },
        "apiEndpoint": { "type": "string" },
        "apiToken": { "type": "string" },
        "sshPort": { "type": "integer" },
        "wireguardPort": { "type": "integer" },
        "openVpnPort": { "type": "integer" },
        "status": { "type": "string", "enum": ["ONLINE", "OFFLINE", "ERROR", "PENDING"] },
        "cpuPercent": { "type": "number" },
        "ramUsedMb": { "type": "integer" },
        "ramTotalMb": { "type": "integer" },
        "storageUsedGb": { "type": "integer" },
        "storageTotalGb": { "type": "integer" },
        "latencyMs": { "type": "integer" },
        "activeConnections": { "type": "integer" },
        "wireguardEnabled": { "type": "boolean" },
        "openVpnEnabled": { "type": "boolean" },
        "lastDiagnostic": { "type": "string" },
        "lastCheckedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ipAddress", "location", "apiEndpoint", "apiToken", "sshPort", "wireguardPort", "openVpnPort", "status", "cpuPercent", "ramUsedMb", "ramTotalMb", "storageUsedGb", "storageTotalGb", "latencyMs", "activeConnections", "wireguardEnabled", "openVpnEnabled", "lastDiagnostic", "createdAt", "updatedAt"]
    },
    "VpnProtocolConfig": {
      "title": "VpnProtocolConfig",
      "description": "WireGuard or OpenVPN protocol daemon configuration bound to a VPS server.",
      "type": "object",
      "properties": {
        "serverId": { "type": "string" },
        "serverName": { "type": "string" },
        "type": { "type": "string", "enum": ["WIREGUARD", "OPENVPN"] },
        "enabled": { "type": "boolean" },
        "port": { "type": "integer" },
        "transport": { "type": "string", "enum": ["UDP", "TCP"] },
        "subnet": { "type": "string" },
        "dns": { "type": "string" },
        "mtu": { "type": "integer" },
        "cipher": { "type": "string" },
        "keepaliveSeconds": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["serverId", "serverName", "type", "enabled", "port", "transport", "subnet", "dns", "mtu", "cipher", "keepaliveSeconds", "createdAt", "updatedAt"]
    },
    "VpnUser": {
      "title": "VpnUser",
      "description": "VPN client account with expiration, device quota, and protocol assignment.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "serverId": { "type": "string" },
        "serverName": { "type": "string" },
        "protocol": { "type": "string", "enum": ["WIREGUARD", "OPENVPN", "BOTH"] },
        "status": { "type": "string", "enum": ["ACTIVE", "SUSPENDED", "EXPIRED"] },
        "maxDevices": { "type": "integer" },
        "activeConnections": { "type": "integer" },
        "dataLimitGb": { "type": "integer" },
        "dataUsedMb": { "type": "integer" },
        "expiresAtEpochMs": { "type": "integer" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["username", "email", "serverId", "serverName", "protocol", "status", "maxDevices", "activeConnections", "dataLimitGb", "dataUsedMb", "expiresAtEpochMs", "notes", "createdAt", "updatedAt"]
    },
    "VpnConfigProfile": {
      "title": "VpnConfigProfile",
      "description": "Generated WireGuard (.conf) or OpenVPN (.ovpn) configuration profile and cryptographic keys.",
      "type": "object",
      "properties": {
        "vpnUserId": { "type": "string" },
        "vpnUsername": { "type": "string" },
        "serverId": { "type": "string" },
        "serverName": { "type": "string" },
        "deviceId": { "type": "string" },
        "deviceName": { "type": "string" },
        "protocol": { "type": "string", "enum": ["WIREGUARD", "OPENVPN"] },
        "assignedIp": { "type": "string" },
        "publicKey": { "type": "string" },
        "privateKey": { "type": "string" },
        "presharedKey": { "type": "string" },
        "endpoint": { "type": "string" },
        "configContent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vpnUserId", "vpnUsername", "serverId", "serverName", "deviceId", "deviceName", "protocol", "assignedIp", "publicKey", "privateKey", "presharedKey", "endpoint", "configContent", "createdAt", "updatedAt"]
    },
    "VpnDevice": {
      "title": "VpnDevice",
      "description": "Authorized client device bound to a VPN user and tunnel IP.",
      "type": "object",
      "properties": {
        "vpnUserId": { "type": "string" },
        "vpnUsername": { "type": "string" },
        "serverId": { "type": "string" },
        "deviceName": { "type": "string" },
        "platform": { "type": "string", "enum": ["ANDROID", "IOS", "WINDOWS", "MACOS", "LINUX", "ROUTER"] },
        "assignedIp": { "type": "string" },
        "publicKeyFingerprint": { "type": "string" },
        "authorized": { "type": "boolean" },
        "connected": { "type": "boolean" },
        "lastSeenEpochMs": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["vpnUserId", "vpnUsername", "serverId", "deviceName", "platform", "assignedIp", "publicKeyFingerprint", "authorized", "connected", "lastSeenEpochMs", "createdAt", "updatedAt"]
    },
    "PanelMember": {
      "title": "PanelMember",
      "description": "Administrator or operator team member with role-based permissions.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["SUPER_ADMIN", "ADMIN", "OPERATOR", "VIEWER"] },
        "status": { "type": "string", "enum": ["ACTIVE", "INVITED", "SUSPENDED"] },
        "twoFactorRequired": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "role", "status", "twoFactorRequired", "createdAt", "updatedAt"]
    },
    "PanelNotification": {
      "title": "PanelNotification",
      "description": "Infrastructure, expiration, and security alerts.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "severity": { "type": "string", "enum": ["INFO", "WARNING", "CRITICAL"] },
        "category": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "message", "severity", "category", "read", "createdAt", "updatedAt"]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Immutable administrative action audit entry.",
      "type": "object",
      "properties": {
        "actorEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetName": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["actorEmail", "action", "targetType", "targetName", "details", "status", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Workspace administrator profile and settings isolated per authenticated UID."
    },
    "/users/{userId}/vpsServers/{serverId}": {
      "schema": { "$ref": "#/entities/VpsServer" },
      "description": "VPS infrastructure nodes owned by the authenticated administrator."
    },
    "/users/{userId}/protocols/{protocolId}": {
      "schema": { "$ref": "#/entities/VpnProtocolConfig" },
      "description": "WireGuard and OpenVPN daemon configurations per VPS node."
    },
    "/users/{userId}/vpnUsers/{vpnUserId}": {
      "schema": { "$ref": "#/entities/VpnUser" },
      "description": "VPN client accounts managed by the administrator."
    },
    "/users/{userId}/vpnConfigs/{configId}": {
      "schema": { "$ref": "#/entities/VpnConfigProfile" },
      "description": "Generated WireGuard and OpenVPN configuration profiles."
    },
    "/users/{userId}/devices/{deviceId}": {
      "schema": { "$ref": "#/entities/VpnDevice" },
      "description": "Authorized client devices bound to VPN accounts."
    },
    "/users/{userId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/PanelMember" },
      "description": "Panel administrative team members and RBAC roles."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/PanelNotification" },
      "description": "System and security alerts for the administrator."
    },
    "/users/{userId}/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Audit log of administrative actions."
    }
  }
}
